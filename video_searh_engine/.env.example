# viewTag — Video Search Engine
# Configuración por variables de entorno
# Copia este archivo a .env y ajusta los valores según tu entorno
# Las variables de entorno tienen prioridad sobre los valores por defecto

# =============================================================================
# QDRANT (Base de datos vectorial local)
# =============================================================================
# Ruta donde Qdrant persiste los datos en disco
QDRANT_STORAGE_PATH=./qdrant_data

# Nombre de la colección en Qdrant
QDRANT_COLLECTION_NAME=video_frames

# Dimensión de los vectores (debe coincidir con el modelo de embeddings)
# SigLIP base patch16-224 = 768 dimensiones
QDRANT_VECTOR_SIZE=768

# =============================================================================
# MODELO DE EMBEDDINGS (SigLIP via Hugging Face)
# =============================================================================
# Nombre del modelo en Hugging Face Hub
# Opciones: google/siglip-base-patch16-224, google/siglip-large-patch16-256, etc.
SIGLIP_MODEL_NAME=google/siglip-base-patch16-224

# Ruta local al modelo (opcional, para uso offline sin descargar de HF)
# Si se especifica, tiene prioridad sobre SIGLIP_MODEL_NAME
SIGLIP_MODEL_PATH=

# =============================================================================
# PROCESAMIENTO DE VIDEO
# =============================================================================
# Frames a extraer por segundo de video (1.0 = 1 frame/seg, 0.5 = 1 frame cada 2 seg)
FPS_SAMPLE_RATE=1.0

# Tamaño de lote para extracción de frames (Decord get_batch)
# Valores altos = más RAM, más rápido. 64 es seguro para mayoría de GPUs/CPUs.
FRAME_BATCH_SIZE=64

# Tamaño de lote para generación de embeddings (SigLIP)
# Valores altos = más VRAM. 32 funciona en GPU de 8GB.
IMAGE_BATCH_SIZE=32

# Tamaño de lote para upsert en Qdrant
UPSERT_BATCH_SIZE=256

# =============================================================================
# API (FastAPI + Uvicorn)
# =============================================================================
# Host donde escuchar (0.0.0.0 = todas las interfaces)
API_HOST=0.0.0.0

# Puerto de la API
API_PORT=8000

# Recarga automática en desarrollo (true/false)
# En producción debe ser false
API_RELOAD=false

# =============================================================================
# LÍMITES DE BÚSQUEDA
# =============================================================================
# Límite por defecto de resultados en /search
SEARCH_DEFAULT_LIMIT=5

# Límite máximo permitido en /search
SEARCH_MAX_LIMIT=50

# Límite mínimo permitido en /search
SEARCH_MIN_LIMIT=1

# =============================================================================
# PROCESAMIENTO DE TEXTO
# =============================================================================
# Longitud máxima de tokens para el texto de búsqueda (tokenizer SigLIP)
TEXT_MAX_LENGTH=64